# Local Docker database. Replace this with the Supabase pooler connection string in production.
DATABASE_URL=postgresql://property_nearby:property_nearby@localhost:5432/property_nearby
DB_SSL=false

# Application API server.
PORT=8000
HOST=0.0.0.0

# TEDUH synchronization controls.
TEDUH_API_BASE=https://teduh.kpkt.gov.my/api
TEDUH_DETAIL_CONCURRENCY=3
TEDUH_REQUEST_DELAY_MS=150
